# Only track what is needed to reproduce the website:
#   sources (.qmd, images, theme, config), pyproject.toml, uv.lock and .python-version.
# Everything below is generated (by uv, Quarto, Python, editors or the OS) and can be recreated.

# ---------- Python / uv (recreate with: uv sync) ----------
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ---------- Quarto (recreate with: uv run quarto render / preview) ----------
# Built website and Quarto's cache
/.quarto_output/
/.quarto/
**/.quarto/
# Intermediate files from executing code cells
**/*.quarto_ipynb
# Files from rendering a single page on its own (e.g. the annual report PDF/Typst export)
*_files/
*.typ
# Generated by the Quarto VS Code extension
.luarc.json

# ---------- Editors ----------
.vscode/
.idea/
*.swp

# ---------- Operating systems ----------
.DS_Store
Thumbs.db
desktop.ini
